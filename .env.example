SITE_NUMBER=1
NEXT_PUBLIC_SITE_NUMBER=1

# Same-origin PHP mailer (production). Leave unset to use /api/submit.php
# NEXT_PUBLIC_SUBMIT_API_URL=https://cart-corner.com/api/submit.php

# Optional SMTP. Leave SMTP_HOST empty to use cPanel PHP mail()
# (create mailbox info@cart-corner.com in cPanel first).
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=smtps
SMTP_USER=
SMTP_PASS=

MAIL_FROM=info@cart-corner.com
MAIL_FROM_NAME=Cart Corner
MAIL_TO=info@cart-corner.com
MAIL_TO_NAME=Cart Corner
