# Copy this file to public_html/.env on the server (do not commit real passwords).
# Leave SMTP_HOST empty to use cPanel PHP mail(). Create mailbox info@cart-corner.com first.
# Payment keys belong in public_html/api/.env (see public/api/.env.example). Do not put mPurse
# secrets in NEXT_PUBLIC_* or client JS.

SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=smtps
SMTP_USER=
SMTP_PASS=

MAIL_FROM=info@cart-corner.com
MAIL_FROM_NAME=Cart Corner
MAIL_TO=info@cart-corner.com
MAIL_TO_NAME=Cart Corner
